@startuml
title discord-api — Domain, DTO, and Persistence Model

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EEF3FF
  BorderColor #3366CC
  FontSize 11
}
skinparam packageStyle rectangle

package "domain" #F3F3F3 {
  class User <<record>> {
    UUID id
    String username
    String displayName
    LocalDateTime joinedAt
  }
  class Guild <<record>> {
    UUID id
    String name
    String description
    LocalDateTime createdAt
  }
  class Role <<record>> {
    UUID id
    String name
    String color
    Integer position
  }
  class Channel <<record>> {
    UUID id
    String name
    ChannelType type
    Integer position
  }
  enum ChannelType {
    TEXT
    VOICE
  }
  Channel --> ChannelType
}

package "application.dto" #F3F3F3 {
  class "UserDTO / GuildDTO" as AggregateDTOs <<response records>>
  class "RoleDTO / ChannelDTO" as ChildDTOs <<response records>>
  class "Create*Request" as CreateDTOs <<validated records>>
  class "Update*Request" as UpdateDTOs <<validated records>>
}

package "infrastructure.persistence" #F3F3F3 {
  class UserEntity <<JPA entity>> {
    UUID id
    String username
    String displayName
    LocalDateTime joinedAt
    Set~GuildEntity~ guilds
    Set~RoleEntity~ roles
  }
  class GuildEntity <<JPA entity>> {
    UUID id
    String name
    String description
    LocalDateTime createdAt
    Set~RoleEntity~ roles
    Set~ChannelEntity~ channels
    Set~UserEntity~ members
  }
  class RoleEntity <<JPA entity>> {
    UUID id
    String name
    String color
    Integer position
    GuildEntity guild
    Set~UserEntity~ users
  }
  class ChannelEntity <<JPA entity>> {
    UUID id
    String name
    ChannelType type
    Integer position
    GuildEntity guild
  }
  class "UserRepository / GuildRepository\nRoleRepository / ChannelRepository" as Repositories
}

UserEntity "*" -- "*" GuildEntity : guild_members
UserEntity "*" -- "*" RoleEntity : user_roles
GuildEntity "1" -- "*" RoleEntity : owns
GuildEntity "1" -- "*" ChannelEntity : owns
ChannelEntity --> ChannelType
Repositories --> UserEntity
Repositories --> GuildEntity
Repositories --> RoleEntity
Repositories --> ChannelEntity

package "infrastructure.mapper" #F3F3F3 {
  class "UserMapper / GuildMapper\nRoleMapper / ChannelMapper" as Mappers
}

CreateDTOs --> Mappers
UpdateDTOs --> Mappers
Mappers ..> User
Mappers ..> Guild
Mappers ..> Role
Mappers ..> Channel
Mappers --> UserEntity
Mappers --> GuildEntity
Mappers --> RoleEntity
Mappers --> ChannelEntity
Mappers --> AggregateDTOs
Mappers --> ChildDTOs

note bottom of AggregateDTOs
  Relations are exposed as
  immutable UUID snapshots.
end note

note bottom of CreateDTOs
  UUIDs and dates are generated
  server-side. Role and Channel
  creation includes guildId.
end note
@enduml
