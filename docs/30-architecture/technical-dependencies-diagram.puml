@startuml
title discord-api — Current Technical Dependencies
left to right direction

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF3FF
  BorderColor #3366CC
  FontSize 11
}

rectangle "Runtime: Quarkus 3.31.2 / Java 21" as Runtime {
  component "REST + Jackson\nquarkus-rest-jackson" as REST
  component "CDI\nquarkus-arc" as CDI
  component "Hibernate ORM + Panache" as ORM
  component "PostgreSQL JDBC" as JDBC
  component "Bean Validation" as Validation
  component "SmallRye OpenAPI" as OpenAPI
  component "SmallRye Health" as Health
}

rectangle "Implemented code" {
  component "Generic API error mappers" as API
  component "DTO records" as DTOs
  component "Discord domain records" as Domain
  component "Mappers" as Mappers
  component "JPA entities + repositories" as Persistence
}

database "PostgreSQL" as Database

rectangle "Test scope" {
  component "JUnit 5 / Quarkus Test" as JUnit
  component "ArchUnit 1.4.1" as ArchUnit
  component "Testcontainers 1.21.4" as Testcontainers
  component "REST Assured" as RestAssured
}

REST --> API
CDI --> Persistence
ORM --> Persistence
JDBC --> Database
Validation --> DTOs
Validation --> Persistence
OpenAPI --> Runtime
Health --> Runtime

DTOs --> Mappers
Mappers --> Domain
Mappers --> Persistence
Persistence --> Database

JUnit --> DTOs : validation and mapper tests
ArchUnit --> Domain : isolation rules
ArchUnit --> API : layer and naming rules
Testcontainers --> Database : ephemeral integration DB
RestAssured --> Health : technical endpoint tests
RestAssured --> OpenAPI : contract availability test

note bottom of API
  No Discord JAX-RS Resource exists yet.
  REST CRUD starts with ticket #17.
end note
@enduml
