@startuml
title discord-api — Implemented Component Diagram
left to right direction

skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF3FF
  BorderColor #3366CC
  FontSize 12
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
}

package "API layer\norg.acme.catalog.product.api" {
  component "Generic exception mappers" as Errors
}

package "Application layer\norg.acme.catalog.product.application" {
  component "Create request records" as CreateRequests
  component "Update request records" as UpdateRequests
  component "Response DTO records" as Responses
}

package "Domain layer\norg.acme.catalog.product.domain" {
  component "User, Guild, Role, Channel\nChannelType" as Domain
}

package "Infrastructure layer\norg.acme.catalog.product.infrastructure" {
  component "UserMapper, GuildMapper\nRoleMapper, ChannelMapper" as Mappers
  component "JPA entities" as Entities
  component "UUID Panache repositories" as Repositories
}

database "PostgreSQL" as Database

CreateRequests --> Mappers : validated input
UpdateRequests --> Mappers : editable fields
Mappers --> Domain : creates / reads records
Mappers --> Entities : creates / updates / reads
Mappers --> Responses : immutable API snapshots
Repositories --> Entities : manages
Entities --> Database : Hibernate ORM / JDBC

note right of Errors
  Implemented infrastructure for
  future REST resources.
end note

note bottom of Responses
  No Discord Resource or Service
  is implemented yet.
  CRUD HTTP work starts at ticket #17.
end note
@enduml
